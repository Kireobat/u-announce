{
  // Basic realm configuration
  "realm": "u-announce",
  "enabled": true,
  "displayName": "uAnnounce",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>uAnnounce</span></div>",

  // Token lifespans (in seconds)
  "accessTokenLifespan": 3600,            // 1 hour
  "refreshTokenMaxReuse": 0,
  "offlineSessionIdleTimeout": 2592000,   // 30 days
  "accessCodeLifespan": 60,               // 1 minute
  "accessCodeLifespanUserAction": 300,    // 5 minutes

  // Security settings - relaxed for development
  "sslRequired": "none",
  "registrationAllowed": true,
  "passwordPolicy": "",                   // No password policy for dev
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,                   // Skip email verification in dev
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": true,

  // Define realm roles
  "roles": {
    "realm": [
      {
        "name": "org_admin",
        "description": "Organization/group admin",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      }
    ]
  },

  // Client configurations
  "clients": [
    {
      // Frontend client (public client for SPAs)
      "clientId": "u-announce-frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,

      // Development redirect URIs
      "redirectUris": [
        "http://localhost:5173/*",        // Vite default
        "http://localhost:8080/*"         // General dev
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:8080"
      ],

      // Default scopes
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      // Backend client (confidential client with a service account)
      "clientId": "u-announce-backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "u-announce-backend-secret",
      "attributes": {
        "jwt.credential.certificate": ""
      },
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email",
        "acr",
        "basic",
        "service-account"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt",
        "organization"
      ]
    }
  ],

  // Test users for development
  "users": [
    {
      "username": "service-account-u-announce",
      "createdAt": 1752059020,
      "emailVerified": false,
      "enabled": true,
      "totp": false,
      "serviceAccountClientId": "u-announce-backend",
      "disableableCredentialTypes": [],
      "requiredActions": [],
      "realmRoles": [
        "default-roles-u-announce"
      ],
      "clientRoles": {
        "realm-management": [
          "query-users",
          "view-realm",
          "manage-realm",
          "view-users",
          "manage-clients",
          "query-groups",
          "view-clients",
          "manage-users"
        ],
        "account": [
          "view-groups"
        ]
      },
      "notBefore": 0,
      "groups": []
    },
    {
      "username": "user",
      "createdAt": 1752059020,
      "enabled": true,
      "email": "user@user.com",
      "firstName": "User",
      "lastName": "User",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-u-announce"
      ]
    }
  ]
}